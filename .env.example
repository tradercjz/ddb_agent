# 默认LLM模型配置（指向 models.json 中的配置名）
DEFAULT_LLM_MODEL=deepseek

# LLM API 限流配置
# 全局 RPM (Requests Per Minute) 限制，默认 60
# 可在 models.json 中为每个模型单独配置
LLM_RPM_LIMIT=60

# 项目路径配置
PROJECT_PATH=.

# Build Index 配置
BUILD_INDEX_WORKER=4

# DolphinDB配置
DDB_HOST=192.168.100.44
DDB_PORT=8848
DDB_USER=admin
DDB_PASSWORD=123456
BAIDU_QIANFAN_TOKEN="bce-v3/ALTAK-Yxxxxxxx"